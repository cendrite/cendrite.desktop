{
  "appId": "com.cendrite.app",
  "productName": "Cendrite",
  "files": ["dist-electron", "dist-react", "node_modules/libsodium-wrappers"],
  "extraResources": ["dist-electron/Electron/Preload.cjs", { "from": "icons", "to": "icons" }],
  "asarUnpack": ["node_modules/@signalapp/libsignal-client/**"],
  "mac": {
    "icon": "./icons/mac.icns",
    "target": "dmg"
  },
  "linux": {
    "icon": "./icons/linux.png",
    "target": "AppImage",
    "category": "Utility"
  },
  "win": {
    "icon": "./icons/win.ico",
    "target": ["nsis"]
  },
  "nsis":{
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "detectUpdateChannel": false,
  "publish": {
    "provider": "generic",
    "url": "https://downloads.cendrite.com/stable"
  }
}
