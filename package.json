{
  "name": "cypherly",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist-electron/Electron/Main.js",
  "scripts": {
    "dev": "npm-run-all --parallel dev:react dev:electron",
    "test": "npm-run-all --parallel test:unit test:integration",
    "dev:react": "vite",
    "dev:electron": "npm run transpile:electron && cross-env NODE_ENV=development electron .",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "transpile:electron": "tsc --project src/Electron/tsconfig.json",
    "dist:mac": "npm run transpile:electron && npm run build && electron-builder --mac --arm64",
    "dist:linux": "npm run transpile:electron && npm run build && electron-builder --linux --x64",
    "dist:win": "npm run transpile:electron && npm run build && electron-builder --win --x64",
    "test:integration": "playwright test && rimraf test-results && rimraf playwright-report",
    "test:full": "start containers && playwright test && stop containers",
    "test:unit": "vitest --run ./Test/Unit",
    "dev:spawn": "node scripts/spawn-dev.js --instances=3"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.1",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@microsoft/signalr": "^8.0.7",
    "@privacyresearch/libsignal-protocol-typescript": "^0.0.16",
    "@tabler/icons-react": "^3.36.0",
    "@types/lodash": "^4.17.20",
    "autoprefixer": "^10.4.20",
    "awilix": "^13.0.5",
    "axios": "^1.7.9",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "formik": "^2.4.6",
    "keytar": "^7.9.0",
    "lodash": "^4.17.21",
    "lottie-react": "^2.4.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.4.0",
    "react-infinite-scroll-component": "^7.2.1",
    "react-modal": "^3.16.3",
    "react-router-dom": "^7.1.0",
    "react-textarea-autosize": "^8.5.9",
    "reflect-metadata": "^0.2.2",
    "sqlite3": "^5.1.7",
    "tailwindcss": "^3.4.17",
    "tweetnacl": "^1.0.3",
    "typeorm": "^0.3.20",
    "uuid": "^11.1.0",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@playwright/test": "^1.49.1",
    "@types/keytar": "^4.4.2",
    "@types/node": "^22.12.0",
    "@types/os-utils": "^0.0.4",
    "@types/plist": "^3.0.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/react-modal": "^3.16.3",
    "@types/verror": "^1.10.10",
    "@vitejs/plugin-react": "^5.1.1",
    "cross-env": "^7.0.3",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.13",
    "globals": "^15.11.0",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.49.1",
    "run-all": "^1.0.1",
    "run-parallel": "^1.2.0",
    "ts-node": "^10.9.2",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.10.0",
    "vite": "^7.1.12",
    "vitest": "^4.0.3"
  }
}
